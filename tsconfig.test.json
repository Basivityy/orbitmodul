{
  "compilerOptions": {
    "target": "ES2022",
    "module": "node16",
    "moduleResolution": "node16",
    "lib": [
      "es2022",
      "dom"
    ],
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "outDir": ".test-build",
    "rootDir": ".",
    "types": [
      "node"
    ]
  },
  "include": [
    "src/core/**/*.ts",
    "tests/**/*.ts",
    "src/lib/appTemplate.ts"
  ]
}