{
  "name": "xui-billing",
  "version": "1.0.0",
  "private": true,
  "description": "Multi-tenant SaaS billing platform for XUI One resellers",
  "scripts": {
    "dev": "next dev",
    "build": "prisma generate && next build",
    "start": "next start -p ${PORT:-3000}",
    "worker": "tsx worker/index.ts",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate deploy",
    "db:seed": "tsx prisma/seed.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 '.test-build/tests/**/*.test.js'",
    "test:unit": "tsc -p tsconfig.test.json && node --test '.test-build/tests/unit/*.test.js'",
    "test:integration": "tsc -p tsconfig.test.json && node --test --test-concurrency=1 '.test-build/tests/integration/*.test.js'"
  },
  "dependencies": {
    "@prisma/client": "^6.2.1",
    "bullmq": "^5.34.8",
    "ioredis": "^5.4.2",
    "next": "^15.1.6",
    "nodemailer": "^6.9.16",
    "prisma": "^6.2.1",
    "qrcode": "^1.5.4",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "tsx": "^4.19.2",
    "zod": "^3.24.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.7",
    "@types/nodemailer": "^6.4.17",
    "@types/qrcode": "^1.5.5",
    "@types/react": "^19.0.7",
    "@types/react-dom": "^19.0.3",
    "autoprefixer": "^10.4.20",
    "postcss": "^8.5.1",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.7.3"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  },
  "engines": {
    "node": ">=20.11"
  }
}
